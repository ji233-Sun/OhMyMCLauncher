{
  "apiVersion": 1,
  "id": "ohmymc.launch-settings",
  "name": "游戏启动参数管理",
  "version": "1.0.0",
  "author": "OhMyMC",
  "description": "为每个版本分别保存 Java、内存、窗口及附加参数，通过启动钩子应用。",
  "entry": "main.js",
  "permissions": ["storage.version", "launch.configure"],
  "actions": {"load": {}, "save": {}},
  "hooks": ["launch.configure"],
  "panels": [{
    "id": "launch", "title": "启动参数", "description": "只影响当前版本。禁用插件后回到内核默认配置，已保存配置仍会保留。", "scope": "version", "kind": "form", "loadAction": "load", "submitAction": "save", "submitLabel": "保存启动配置",
    "fields": [
      {"key": "playerName", "label": "本地离线名称", "type": "text", "required": true, "description": "1–16 位英文字母、数字或下划线。不是微软登录，无法进入正版验证服务器。"},
      {"key": "javaPath", "label": "Java 可执行文件", "type": "text", "placeholder": "留空自动检测 Java", "description": "填写 java.exe / java 的完整路径；不会自动下载 Java。"},
      {"key": "minMemoryMB", "label": "最小内存 · MiB", "type": "number", "min": 128, "max": 262144, "required": true},
      {"key": "maxMemoryMB", "label": "最大内存 · MiB", "type": "number", "min": 128, "max": 262144, "required": true},
      {"key": "width", "label": "窗口宽度", "type": "number", "min": 320, "max": 16384, "required": true},
      {"key": "height", "label": "窗口高度", "type": "number", "min": 240, "max": 16384, "required": true},
      {"key": "fullscreen", "label": "以全屏模式启动", "type": "checkbox"},
      {"key": "jvmArgs", "label": "附加 JVM 参数", "type": "textarea", "placeholder": "-XX:+UseG1GC", "description": "一行一个完整参数，不要额外加 shell 引号。仅填写你信任的参数；Java agent 可执行代码。"},
      {"key": "gameArgs", "label": "附加游戏参数", "type": "textarea", "placeholder": "--server\nlocalhost", "description": "一行一个参数，参数名与值分别占一行。"}
    ]
  }]
}
